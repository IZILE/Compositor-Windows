<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Compositor.Core\Compositor.Core.csproj" />
    <EmbeddedResource Include="Locale\zh-CN.json" LogicalName="Compositor.Desktop.Locale.zh-CN.json" />
    <EmbeddedResource Include="Assets\Compositor.png" LogicalName="Compositor.Desktop.AppIcon.png" />
    <EmbeddedResource Include="Assets\Compositor.ico" LogicalName="Compositor.Desktop.AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

  <PropertyGroup>
    <!-- This independent Windows build has its own version and update channel. -->
    <Version>0.6.6</Version>
    <AssemblyName>Compositor</AssemblyName>
    <Product>Compositor Windows Community</Product>
    <Description>Independent Windows image editor based on the Compositor community port.</Description>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\Compositor.ico</ApplicationIcon>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The canvas copies a rendered piece into the screen's pixel order. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
